# Claude files
.claude/

# Build artifacts
bin/local/
__pycache__/
# (Binaries are committed as part of the plugin distribution)
!bin/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
tmp/
temp/
*.tmp

# User configuration (should be set by users)
config/user-config.json

# Test outputs
test-outputs/*
!test-outputs/.gitkeep
*.ase
*.aseprite
*.png
*.gif

# Apple example: keep curated exports; local regeneration stays untracked.
examples/apple/generated/
examples/apple/.venv/
!examples/apple/assets/*.aseprite
!examples/apple/assets/*.png
!examples/apple/assets/*.gif
