#!/bin/bash
# Wrapper script to select the correct pixel-mcp binary for the current platform

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Explicit development override. Never silently fall back after a bad override.
if [ -n "${PIXEL_MCP_BINARY:-}" ]; then
    case "$PIXEL_MCP_BINARY" in
        /*|[A-Za-z]:[\\/]*) ;;
        *) echo "Error: PIXEL_MCP_BINARY must be an absolute executable path" >&2; exit 1 ;;
    esac
    if [ ! -f "$PIXEL_MCP_BINARY" ] || [ ! -x "$PIXEL_MCP_BINARY" ]; then
        echo "Error: PIXEL_MCP_BINARY is not executable: $PIXEL_MCP_BINARY" >&2
        exit 1
    fi
    if [ "$PIXEL_MCP_BINARY" -ef "$SCRIPT_DIR/pixel-mcp" ]; then
        echo "Error: PIXEL_MCP_BINARY must point to a server binary, not this wrapper" >&2
        exit 1
    fi
    exec "$PIXEL_MCP_BINARY" "$@"
fi

# Detect platform
OS="$(uname -s)"
ARCH="$(uname -m)"

case "$OS" in
    Darwin)
        case "$ARCH" in
            x86_64)
                BINARY="$SCRIPT_DIR/pixel-mcp-darwin-amd64"
                ;;
            arm64)
                BINARY="$SCRIPT_DIR/pixel-mcp-darwin-arm64"
                ;;
            *)
                echo "Error: Unsupported macOS architecture: $ARCH" >&2
                exit 1
                ;;
        esac
        ;;
    Linux)
        case "$ARCH" in
            x86_64)
                BINARY="$SCRIPT_DIR/pixel-mcp-linux-amd64"
                ;;
            aarch64|arm64)
                BINARY="$SCRIPT_DIR/pixel-mcp-linux-arm64"
                ;;
            *)
                echo "Error: Unsupported Linux architecture: $ARCH" >&2
                exit 1
                ;;
        esac
        ;;
    MINGW*|MSYS*|CYGWIN*)
        BINARY="$SCRIPT_DIR/pixel-mcp-windows-amd64.exe"
        ;;
    *)
        echo "Error: Unsupported operating system: $OS" >&2
        exit 1
        ;;
esac

if [ ! -x "$BINARY" ]; then
    echo "Error: Binary not found or not executable: $BINARY" >&2
    exit 1
fi

# Execute the appropriate binary with all arguments
exec "$BINARY" "$@"
